    {
      "name": "02 - Create Complaints (POST /api/complaints)",
      "item": [
        {
          "name": "Create Complaint 1 - Infrastructure (High Priority)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (res.success && res.data && res.data._id) {",
                  "    pm.collectionVariables.set(\"complaint_id\", res.data._id);",
                  "    console.log(\"Saved complaint_id:\", res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentName\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@campus.edu\",\n  \"title\": \"Broken Projector in Lecture Hall 3B\",\n  \"description\": \"The ceiling projector flickers constantly and shuts down every 10 minutes during classes.\",\n  \"category\": \"Infrastructure\",\n  \"priority\": \"High\",\n  \"location\": \"Science Block, Room 3B\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/complaints",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints"]
            },
            "description": "Creates an Infrastructure complaint. Automatically saves `complaint_id` for subsequent requests."
          },
          "response": []
        },
